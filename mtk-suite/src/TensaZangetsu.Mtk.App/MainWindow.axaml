<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TensaZangetsu.Mtk.App.MainWindow"
        Width="900" Height="620"
        Title="Tensa-Zangetsu MTK Suite"
        Background="#0B0F0C">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
    <TextBlock Text="TENSA-ZANGETSU / MTK" FontSize="24" Foreground="#00FF66" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,18,0,12">
      <Button x:Name="IdentifyButton" Content="IDENTIFY BROM / PRELOADER" Click="Identify" />
      <Button x:Name="CancelButton" Content="CANCEL" Click="Cancel" IsEnabled="False" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#B8FFDA" />
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="18">
      <Border BorderBrush="#00CC44" BorderThickness="1" Padding="12">
        <TextBox x:Name="InfoText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#000000" />
      </Border>
      <Border Grid.Column="1" BorderBrush="#00CC44" BorderThickness="1" Padding="12">
        <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#000000" />
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="No operation is simulated. Hardware writes remain disabled until a validated MTK plan is loaded." Foreground="#FFD700" Margin="0,12,0,0" />
  </Grid>
</Window>
