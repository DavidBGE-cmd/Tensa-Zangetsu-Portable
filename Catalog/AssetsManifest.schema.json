{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensa-zangetsu.local/schemas/AssetsManifest.schema.json",
  "title": "Tensa-Zangetsu asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceRoots", "assets", "bundles", "duplicateGroups", "unifiedPreloadersDb", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "members"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "members": { "type": "array", "items": { "$ref": "#/$defs/asset" } } }
      }
    },
    "duplicateGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "relativePaths"],
        "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "relativePaths": { "type": "array", "minItems": 2, "items": { "type": "string" } } }
      }
    },
    "unifiedPreloadersDb": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["info", "warning", "error"] },
          "code": { "type": "string" },
          "relativePath": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rootId", "relativePath", "length", "lastWriteTimeUtc", "sha256", "kind", "verificationStatus", "metadataSource", "modelCodes"],
      "properties": {
        "id": { "type": "string", "pattern": "^asset-[0-9a-f]{20}$" },
        "rootId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "relativePath": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/.+$" },
        "length": { "type": "integer", "minimum": 0 },
        "lastWriteTimeUtc": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": {
          "enum": [
            "Unknown", "BinaryUnknown", "MtkDownloadAgentCandidate", "PreloaderCandidate",
            "FirehoseProgrammerCandidate", "SprdFdlCandidate", "Scatter",
            "FirehoseRawProgram", "FirehosePatch", "PacPackageCandidate",
            "SamsungPitCandidate", "FirmwareArchiveCandidate", "TestPointImage",
            "Image", "MetadataSidecar"
          ]
        },
        "verificationStatus": {
          "enum": ["ReferenceOnly", "IndexedUnverified", "ImplementedUntested", "Verified", "Unavailable"]
        },
        "metadataSource": { "type": "string" },
        "brand": { "type": ["string", "null"] },
        "soc": { "type": ["string", "null"] },
        "modelCodes": { "type": "array", "items": { "type": "string" } },
        "boardRevision": { "type": ["string", "null"] },
        "protocolFamily": { "type": ["string", "null"] },
        "bitConstraint": { "type": ["string", "null"] },
        "androidConstraint": { "type": ["string", "null"] },
        "hyperOsConstraint": { "type": ["string", "null"] },
        "storageConstraint": { "type": ["string", "null"] },
        "bundleId": { "type": ["string", "null"] },
        "bundleRole": { "type": ["string", "null"] },
        "provenance": { "type": ["string", "null"] }
      }
    }
  }
}
